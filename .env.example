# Copie para `.env` e ajuste. O `.env` não vai para o repositório.

# --- Aplicação ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Banco ---
# POSTGRES_HOST é sobrescrito para `db` pelo docker-compose.
# Use `localhost` apenas para rodar a API fora do compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen
POSTGRES_DB=lumen

# --- Recuperação (RAG) ---
# A dimensão do embedding não é variável de ambiente: é EMBEDDING_DIM, constante
# em app/core/constants.py, porque faz parte do tipo da coluna vector(n).
RETRIEVAL_TOP_K=5
KNOWLEDGE_BASE_PATH=knowledge-base

# --- Portas expostas no host ---
API_PORT=8000
POSTGRES_PORT_HOST=5432
