# Copie para `.env` e ajuste. O `.env` não vai para o repositório.

# --- Aplicação ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
# SQL_ECHO=true imprime cada SQL executado pelo SQLAlchemy no terminal.
# Desligado por padrão porque afoga o relatório de scripts/ingest.py; ligue
# só para depurar uma query específica.
SQL_ECHO=false

# --- Banco ---
# POSTGRES_HOST é sobrescrito para `db` pelo docker-compose.
# Use `localhost` apenas para rodar a API fora do compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen
POSTGRES_DB=lumen

# DATABASE_URL, se definida, substitui as cinco variáveis POSTGRES_* acima.
# Não a defina localmente — é assim que o Railway injeta a conexão do
# serviço Postgres (template pgvector) no serviço da aplicação, via
# ${{Postgres.DATABASE_URL}}. Vem como `postgresql://...`; a aplicação
# converte para `postgresql+asyncpg://` sozinha.
# DATABASE_URL=

# MIGRATION_DATABASE_URL, se definida, é a DSN usada só pela migration
# (alembic upgrade head), no lugar de DATABASE_URL. Deixe vazia localmente —
# sem distinção entre rede pública e privada, a migration usa a mesma URL da
# aplicação. No Railway ela recebe ${{Postgres.DATABASE_PUBLIC_URL}}: o
# preDeployCommand roda antes da rede privada (postgres.railway.internal)
# ficar resolvível, então a migration precisa da URL pública; a aplicação em
# execução continua na privada, via DATABASE_URL.
# MIGRATION_DATABASE_URL=

# --- Recuperação (RAG) ---
# A dimensão do embedding e os modelos usados não são variável de ambiente:
# são EMBEDDING_DIM, MODELO_EMBEDDING_DOCUMENTOS e MODELO_EMBEDDING_CONSULTAS,
# constantes em app/core/constants.py, porque a dimensão faz parte do tipo da
# coluna vector(n) e o modelo determina essa dimensão.
RETRIEVAL_TOP_K=5
KNOWLEDGE_BASE_PATH=knowledge-base

# Chave da API da Voyage AI (embeddings), usada por app/embeddings.py e por
# scripts/ingest.py. Sem ela, a geração de embeddings falha com mensagem
# clara; o parsing e a reconciliação (scripts/ingest.py --sem-embeddings)
# funcionam sem ela.
VOYAGE_API_KEY=

# --- Portas expostas no host ---
API_PORT=8000
POSTGRES_PORT_HOST=5432

# PORT: não defina localmente. O Railway injeta essa variável em tempo de
# execução com a porta que o serviço deve escutar, e o Dockerfile lê `$PORT`
# no CMD. Localmente quem decide a porta é o `command` do docker-compose.
# PORT=
